# Runtime environment for the API: development, test, or production.
LIFESPACE_ENVIRONMENT=development
# SQLAlchemy async URL of the local development database.
LIFESPACE_DATABASE_URL=postgresql+asyncpg://lifespace:lifespace_dev_only@127.0.0.1:5433/lifespace
# SQLAlchemy async URL of the local test database, used by integration tests.
LIFESPACE_TEST_DATABASE_URL=postgresql+asyncpg://lifespace:lifespace_dev_only@127.0.0.1:5433/lifespace_test
# Log level for the API process.
LIFESPACE_LOG_LEVEL=INFO
# Vite dev server proxy target for /api requests.
API_PROXY_TARGET=http://127.0.0.1:8000
# PostgreSQL role created in the local container.
POSTGRES_USER=lifespace
# PostgreSQL password for local use only; never a real secret.
POSTGRES_PASSWORD=lifespace_dev_only
# PostgreSQL database created in the local container.
POSTGRES_DB=lifespace
# Host port the database container is published on (loopback only).
POSTGRES_PORT=5433
